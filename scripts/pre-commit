#!/bin/sh
# Sır sızmasını commit anında durdurur.
#
# .gitignore bir dosyayı korur, deseni korumaz: anahtarı yanlışlıkla bir
# .py dosyasına, bir README örneğine ya da bir teste yapıştırırsan
# .gitignore'un haberi olmaz. Bu kanca içeriğe bakıyor.
#
# Kurulum: scripts/install-hooks.sh
#
# Acil durumda atlatmak için: git commit --no-verify
# (Bunu yapmadan önce iki kez düşün. Bir commit'ten anahtar silmek,
#  geçmişi yeniden yazmak demek.)

kirli=0

# 1) .env ve türevleri hiç sahnelenmemeli.
for dosya in $(git diff --cached --name-only --diff-filter=ACM); do
    case "$dosya" in
        .env|.env.*|*.key|*.pem)
            if [ "$dosya" != ".env.example" ]; then
                echo "RED: '$dosya' sahnelendi. Sır dosyaları repoya girmez."
                kirli=1
            fi
            ;;
    esac
done

# 2) İçerikte anahtar deseni.
#    Anthropic, OpenAI, ElevenLabs, AWS, GitHub ve genel özel anahtar başlığı.
desenler='sk-ant-api[0-9]{2}-[A-Za-z0-9_-]{20}|sk-[A-Za-z0-9]{40,}|sk_[a-f0-9]{40,}|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{30,}|-----BEGIN [A-Z ]*PRIVATE KEY-----'

bulunan=$(git diff --cached -U0 --diff-filter=ACM | grep -nE "^\+" | grep -E "$desenler")
if [ -n "$bulunan" ]; then
    echo "RED: sahnelenen değişiklikte anahtara benzeyen bir dize var:"
    echo "$bulunan" | sed -E 's/(.{0,24}).*/\1…/' | head -5
    kirli=1
fi

if [ "$kirli" -ne 0 ]; then
    echo ""
    echo "Commit durduruldu. Anahtarları .env içine koy — o dosya .gitignore'da."
    exit 1
fi
